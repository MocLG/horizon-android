#!/bin/sh
# The NDK's clang is an x86_64 binary. This prefers the host's own clang
# against the NDK's sysroot and runtime libraries, and falls back to the NDK's
# clang when the host has none, as on a GitHub runner.
: "${ANDROID_HOME:=${ANDROID_SDK_ROOT:-$HOME/android-sdk}}"
: "${ANDROID_NDK_HOME:=$(printf "%s\n" "$ANDROID_HOME"/ndk/* | sort -V | tail -n 1)}"
: "${HORIZON_ANDROID_API:=29}"
llvm="$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64"
resource=$(printf "%s\n" "$llvm"/lib/clang/* | sort -V | tail -n 1)
clang=${HOST_CLANG:-}
[ -n "$clang" ] || clang=$(command -v clang || true)
[ -n "$clang" ] || clang="$llvm/bin/clang"
exec "$clang" --target="aarch64-linux-android$HORIZON_ANDROID_API" \
	--sysroot="$llvm/sysroot" -resource-dir "$resource" -fuse-ld=lld -rtlib=compiler-rt -unwindlib=libunwind -Qunused-arguments "$@"
